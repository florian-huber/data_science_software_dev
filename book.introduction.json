"column":1},"end":{"line":16,"column":1}},"key":"HIE46CiGvw"}],"identifier":"grenzen-des-notebooks","label":"Grenzen des Notebooks","html_id":"grenzen-des-notebooks","implicit":true,"key":"rU9XococAJ"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Jupyter Notebooks sind für viele Anwendungen im Data Science Bereich sehr nützlich und werden darum aus gutem Grund in der Praxis sehr häufig verwendet. Besonders geeignet sind Jupyter Notebooks für das schnelle Testen und Erkunden (“Prototyping”). Wenn sie sehr ordentlich erstellt werden, eignen sie auch sehr gut um Prozesse zu dokumentieren (Stichwort: “Literate Programming”).","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"WTG7ySc1Dc"}],"key":"mnqB1ZeI4b"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Allerdings hat diese Form zu arbeiten einige sehr wichtige Begrenzungen!\nWer schon häufig mit anderen im Team gearbeitet hat, wird möglicherweise schon festgestellt haben, das es nicht besonders einfach ist mit mehreren Leuten gemeinsam an Jupyter Notebooks zu arbeiten. Und auch wenn sauber erstelltes und dokumentiertes Notebook gut lesbar sein kann, bedeutete das noch lange nicht, dass es auch bei anderen im Team direkt ausführbar ist.\nWir kommen also recht schnell an Grenzen, ab denen Jupyter Notebooks nicht mehr nutzbar, oder zumindest nicht sehr praktisch sind. Genau in diesen Bereich möchten wir uns in diesem Kurs vortasten. Es geht um das Erlernen und Anwenden von Schlüsseltechniken die euch erlauben werden, professionelle Data Science Workflows zu entwickeln und zu implementieren die deutlich den Rahmen von Jupyter Notebooks sprengen, sei es durch höhere Komplexität, erhöhte Verlässlichkeit und Reproduzierbarkeit, oder stark verbesserte Performance.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"nBVAzd4F0p"}],"key":"vbv6sOGqBR"},{"type":"heading","depth":3,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Getting serious","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"ujk9wvuWL6"}],"identifier":"getting-serious","label":"Getting serious","html_id":"getting-serious","implicit":true,"key":"GQVmug6art"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Falls es unser Ziel war, nur einmalig bestimmte Analysen durchzuführen, Korrelationen zu finden, eine erste Aussage zu treffen etc., dann kann es gut sein, dass ein komplettes Data Science Projekt vollständig in Jupyter Notebook(s) umsetzbar ist. Das fertige Notebook und die damit generierten Grafiken sind quasi unser Endprodukt und wir können unser Projekt danach abschließen.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"IHes2uSl9r"}],"key":"hE0OQQTUrY"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Häufig geht ein Projekt aber deutlich weiter, etwa wenn:","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"FJz5e0ahj6"}],"key":"zBnKgHU7cy"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":30,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"eine Analyse auf verschiedenen Datensätzen, durch verschiedene Personen, oder zu verschiedenen Zeitpunkten erneut durchgeführt werden soll (Stichwort: “Reproduzierbarkeit”)","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"VOEveimM3D"}],"key":"uDlN46lrWQ"}],"key":"OgJk26kSuY"},{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"ein Produkt das Ziel des Projektes ist. Zum Beispiel ein Machine Learning Modell das später in einer bestimmten Software verwendet werden soll. Oder eine Web-App, ein Dashboard, eine Erkennungsmethode usw.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"IWhBDYPszK"}],"key":"OaaQGFsLsH"}],"key":"sUn7j3Gt0T"},{"type":"listItem","spread":true,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"die Abläufe/Analysen in eine umfangreicher Software (oder auch ein umfangreicheren Workflow) eingefügt werden sollen.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"e2hNOkbJng"}],"key":"jUwcHZojis"}],"key":"YzrUceqQJc"},{"type":"listItem","spread":true,"position":{"start":{"line":33,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"weitere Optimierungsschritte nötig sind","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"ww2YfQF2Ji"}],"key":"oZysAfVx56"}],"key":"bZNAJ7V7ij"}],"key":"kokiLDtwn2"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Um auf diese Stufe zu kommen müssen wir uns mit einigen Aspekten aus dem Bereich Softwareentwicklung vertraut machen. Wichtige Ziele sind dabei:","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"vslbBRJ9qi"}],"key":"V894503F1y"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":37,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Code schreiben der verlässlich ist (au